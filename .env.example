MATRIX_HOMESERVER= # Set the URL of your Matrix homeserver.
MATRIX_USER_ID= # Set the Matrix user ID for the bot.
MATRIX_ROOM_ID= #Get from going to the room in your Matrix client and copying the room ID from the room settings.
MATRIX_DATABASE_URI= # Set the URI for your MongoDB instance.
MATRIX_DATABASE_NAME= # Set the name of the MongoDB database to use for persistence.